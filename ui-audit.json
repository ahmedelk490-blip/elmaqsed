{
  "name": "elmaqsed",
  "build": "npm run build",
  "start": "set \"USERPROFILE=D:\\dev-cache\\elmaqsed-audit-home\" && npx next start -p 3599",
  "url": "http://localhost:3599",
  "live": "https://elmaqsed.com",
  "widths": [
    336,
    375,
    414,
    768,
    1024,
    1280
  ],
  "fullWidths": [
    336
  ],
  "ignore": [
    "[aria-hidden=\"true\"]",
    ".ghost",
    ".marquee",
    ".dtrack",
    ".mtrack",
    ".orb",
    ".ripple-ring",
    ".sym-glow",
    ".ignite"
  ],
  "pages": [
    "/",
    "/services",
    "/destinations",
    "/process",
    "/about",
    "/faq",
    "/contact",
    "/booking",
    "/visa/france",
    "/visa/uk",
    "/visa/turkey",
    "/visa/malaysia",
    "/visa/usa",
    "/admin/login"
  ],
  "discover": [
    "/",
    "/booking"
  ],
  "discoverWidths": [
    336,
    768
  ],
  "states": [
    {
      "name": "visa-picker",
      "page": "/",
      "steps": [
        {
          "click": ".hs-bar .hs-field >> nth=0"
        }
      ]
    },
    {
      "name": "hotel-guests",
      "page": "/",
      "steps": [
        {
          "click": ".hs-tab >> nth=1"
        },
        {
          "click": ".hs-wide"
        }
      ]
    },
    {
      "name": "hotel-suggest",
      "page": "/",
      "steps": [
        {
          "click": ".hs-tab >> nth=1"
        },
        {
          "fill": [
            ".hs-hotel .hs-input >> nth=0",
            "بار"
          ]
        },
        {
          "wait": 400
        }
      ]
    },
    {
      "name": "esim-picker",
      "page": "/",
      "steps": [
        {
          "click": ".hs-tab >> nth=2"
        },
        {
          "click": ".hs-esim .hs-field >> nth=0"
        }
      ]
    },
    {
      "name": "packages",
      "page": "/",
      "steps": [
        {
          "click": ".hs-tab >> nth=3"
        }
      ]
    },
    {
      "name": "menu",
      "page": "/",
      "maxWidth": 1023,
      "steps": [
        {
          "click": ".hdr-burger"
        }
      ]
    },
    {
      "name": "booking-hotel",
      "page": "/booking?service=hotel"
    },
    {
      "name": "booking-esim",
      "page": "/booking?service=esim"
    },
    {
      "name": "booking-visa-travellers",
      "page": "/booking?dest=france",
      "steps": [
        {
          "fill": [
            "#form input[type=date]",
            "2027-01-20"
          ]
        },
        {
          "click": "#form button:has-text(\"حفظ واستمرار\")"
        }
      ]
    },
    {
      "name": "booking-hotel-review",
      "page": "/booking?service=hotel&city=Dubai&in=2027-01-20&out=2027-01-25&adults=2&kids=1&infants=1",
      "steps": [
        {
          "click": "#form button:has-text(\"حفظ واستمرار\")"
        },
        {
          "fill": [
            "#form input >> nth=0",
            "Test"
          ]
        },
        {
          "fill": [
            "#form input[type=tel]",
            "0500000000"
          ]
        },
        {
          "click": "#form button:has-text(\"حفظ واستمرار\")"
        }
      ]
    },
    {
      "name": "call-button",
      "page": "/services",
      "maxWidth": 1023,
      "steps": [
        {
          "press": "End"
        },
        {
          "wait": 600
        }
      ]
    },
    {
      "name": "admin-dashboard",
      "page": "/admin/login",
      "steps": [
        {
          "fill": [
            "[name=username]",
            "audit"
          ]
        },
        {
          "fill": [
            "[name=password]",
            "audit-local-only"
          ]
        },
        {
          "click": "form button"
        },
        {
          "wait": 1200
        }
      ]
    },
    {
      "name": "admin-menu",
      "page": "/admin",
      "maxWidth": 767,
      "steps": [
        {
          "click": ".a-burger"
        }
      ]
    },
    {
      "name": "admin-bookings",
      "page": "/admin/bookings"
    },
    {
      "name": "admin-contacts",
      "page": "/admin/contacts"
    },
    {
      "name": "admin-account",
      "page": "/admin/account"
    },
    {
      "name": "admin-settings",
      "page": "/admin/single/site"
    },
    {
      "name": "admin-countries",
      "page": "/admin/countries"
    },
    {
      "name": "admin-esim",
      "page": "/admin/esim"
    }
  ],
  "allow": [
    {
      "type": "overlap",
      "el": "img.kenburns",
      "why": "the small ELMAQSED caption tag sits on the inner-page photo frame by design (live since 2026-09-28)"
    },
    {
      "type": "field-text-cut",
      "el": "input.a-input",
      "at": "admin-",
      "why": "dashboard text fields hold long values (hours, descriptions); a text input scrolls them, nothing is lost"
    }
  ],
  "note": "The audit server keeps its data in D:/dev-cache/elmaqsed-audit-home (a local test dashboard user 'audit' that exists only there, plus sample bookings and calls). Never the production data."
}
